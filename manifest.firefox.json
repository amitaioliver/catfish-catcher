{
  "manifest_version": 3,
  "name": "Catfish Catcher for LinkedIn",
  "version": "0.8.0",
  "description": "Spot fake profiles, job scams and copied posts on LinkedIn. Free, and nothing leaves your browser.",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "catfish-catcher@extension.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}